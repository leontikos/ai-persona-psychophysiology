# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Root folder holding the study data. Every script derives its input and output
# paths from this one variable; see README.md, "Data layout".
STUDY_DATA_ROOT=/absolute/path/to/study_data

# Required by chatbot/streamlit_app.py (GPT-4o persona delivery), by
# analysis/conversations_analysis/analysis_pipeline_with_gpt.py (GPT-4.1 coding) and by
# analysis/conversations_analysis/recode_batch.py (re-coding; not needed for its report stage).
OPENAI_API_KEY=

# Required only by analysis/conversations_analysis/recode_batch.py (submit, status, collect, resync).
ANTHROPIC_API_KEY=
